#: othello/common/command.py:309
msgid ""
"Usage: new [-h] [-V] [-v] [-d] [-b] [-t TIME] [-g] [-c] [-s {6,8,10,12}].\n"
"\n"
"               [-a [AI]] [--ai-time AI_TIME]\n"
"               [--ai-mode {minimax,iterative,mcts}]\n"
"               [--ai-mcts-selection {UCT,ML,DL}]\n"
"               [--ai-minimax-depth AI_MINIMAX_DEPTH]\n"
"               [--ai-minimax-scoring AI_MINIMAX_SCORING]\n"
"               [--server [SERVER]] [--daemon]\n"
"               [-l {en,fr}]\n"
"               [file]\n"
"            Usage in Lobby: new <player_id>\n"
"\n"
"Othello Game\n"
"\n"
"positional arguments:\n"
"  file                  File to load (game save or contest file)\n"
"\n"
"options:\n"
"  -h, --help            show this help message and exit\n"
"  -V, --version         show program's version number and exit\n"
"  -v, --verbose         Increase verbosity\n"
"  -d, --debug           Show debug messages\n"
"  -b, --blitz           Enable blitz mode\n"
"  -t, --time TIME       Time limit in minutes for blitz mode\n"
"  -g, --gui             Launch GUI\n"
"  -c, --contest         Contest mode\n"
"  -s, --size {6,8,10,12}\n"
"                        Board size (6, 8, 10 or 12). Default = 8.\n"
"  -a, --ai [AI]         Enable AI for a color (or all)\n"
"  --ai-time AI_TIME     AI thinking time in seconds\n"
"  --ai-mode {minimax,iterative,mcts}\n"
"                        AI algorithm mode\n"
"  --ai-mcts-selection {UCT,ML,DL}\n"
"                        MCTS Selection algorithm\n"
"  --ai-minimax-depth AI_MINIMAX_DEPTH\n"
"                        Minimax depth\n"
"  --ai-minimax-scoring AI_MINIMAX_SCORING\n"
"                        Minimax scoring function\n"
"  --server, -S [SERVER]\n"
"                        Start as server on port\n"
"  --daemon              Run server in daemon mode\n"
"  -l, --lang {en,fr}    Choose language\n"
"\n"
"Note: When connected to a server, 'new <player_id>' sends a game invitation.\n"
msgstr ""
"Utilisation : nouveau [-h] [-V] [-v] [-d] [-b] [-t TIME] [-g] [-c] [-s {6,8,10,12}].\n"
"\n"
"               [-a [AI]] [--ai-time AI_TIME]\n"
"               [--ai-mode {minimax,iterative,mcts}]\n"
"               [--ai-mcts-sélection {UCT,ML,DL}]\n"
"               [--ai-minimax-profondeur AI_MINIMAX_DEPTH]\n"
"               [--ai-minimax-scoring AI_MINIMAX_SCORING]\n"
"               [--server [SERVEUR]] [--démon]\n"
"               [-l {en,fr}]\n"
"               [fichier]\n"
"            Utilisation dans le lobby : nouveau <player_id>\n"
"\n"
"Jeu Othello\n"
"\n"
"arguments de position :\n"
"  file Fichier à charger (sauvegarde du jeu ou fichier du concours)\n"
"\n"
"choix :\n"
"  -h, --help afficher ce message d'aide et quitter\n"
"  -V, --version affiche le numéro de version du programme et quitte\n"
"  -v, --verbose Augmente la verbosité\n"
"  -d, --debug Afficher les messages de débogage\n"
"  -b, --blitz Activer le mode blitz\n"
"  -t, --time TIME Limite de temps en minutes pour le mode blitz\n"
"  -g, --gui Lancer l'interface graphique\n"
"  -c, --contest Mode concours\n"
"  -s, --size {6,8,10,12}\n"
"                        Taille du tableau (6, 8, 10 ou 12). Par défaut = 8.\n"
"  -a, --ai [AI] Activer l'IA pour une couleur (ou toutes)\n"
"  --ai-time AI_TIME Temps de réflexion de l'IA en secondes\n"
"  --ai-mode {minimax,iterative,mcts}\n"
"                        Mode algorithme IA\n"
"  --ai-mcts-sélection {UCT,ML,DL}\n"
"                        Algorithme de sélection MCTS\n"
"  --ai-minimax-profondeur AI_MINIMAX_DEPTH\n"
"                        Profondeur minimax\n"
"  --ai-minimax-scoring AI_MINIMAX_SCORING\n"
"                        Fonction de notation Minimax\n"
"  --server, -S [SERVER]\n"
"                        Démarrer en tant que serveur sur le port\n"
"  --daemon Exécuter le serveur en mode démon\n"
"  -l, --lang {en,fr} Choisir la langue\n"
"\n"
"Remarque : Lorsqu'il est connecté à un serveur, 'new <player_id>' envoie une invitation à jouer.\n"

#: othello/common/command.py:357
msgid ""
"Usage: <Color> <Coordinates>\n"
"Plays a move on the board.\n"
"Example: 'X E4', 'O d3'"
msgstr ""
"Utilisation : <Couleur> <Coordonnées>\n"
"Joue un coup sur le plateau.\n"
"Exemple : 'X E4', 'O d3'"

#: othello/common/command.py:362
msgid ""
"Usage: save <filename> [comment]\n"
"Saves the current game state to a file.\n"
"Example: 'save mygame.json', 'save backup \"Easy win\"'"
msgstr ""
"Utilisation : save <filename> [commentaire]\n"
"Enregistre l'état actuel du jeu dans un fichier.\n"
"Exemple : 'enregistrer mon jeu.json', 'enregistrer la sauvegarde \"Easy win\"'"

#: othello/common/command.py:367
msgid ""
"Usage: load <filename>\n"
"Loads a game state from a file.\n"
"Example: 'load mygame.json'"
msgstr ""
"Utilisation : charger <nom de fichier>\n"
"Charge un état de jeu à partir d'un fichier.\n"
"Exemple : « charger mon jeu.json »"

#: othello/common/command.py:372
msgid ""
"Usage: undo [N]\n"
"Cancels the last N moves (default is 1).\n"
"Example: 'undo', 'undo 3'"
msgstr ""
"Utilisation : annuler [N]\n"
"Annule les N derniers mouvements (la valeur par défaut est 1).\n"
"Exemple : « annuler », « annuler 3 »"

#: othello/common/command.py:377
msgid ""
"Usage: redo [N]\n"
"Replays the last N canceled moves (default is 1).\n"
"Example: 'redo', 'redo 2'"
msgstr ""
"Utilisation : refaire [N]\n"
"Rejoue les N derniers coups annulés (la valeur par défaut est 1).\n"
"Exemple : \"refaire\", \"refaire 2\""

#: othello/common/command.py:382
msgid ""
"Usage: show <target>\n"
"Displays information about the game state.\n"
"Targets:\n"
" - board : Display the board\n"
" - history : Display move history\n"
" - time : Display remaining time\n"
" - configuration : Display current settings"
msgstr ""
"Utilisation : afficher <cible>\n"
"Affiche des informations sur l'état du jeu.\n"
"Cibles :\n"
" - board : Afficher le tableau\n"
" - historique : Afficher l'historique des mouvements\n"
" - time : Afficher le temps restant\n"
" - configuration : Afficher les paramètres actuels"

#: othello/common/command.py:391
msgid ""
"Usage: set <param>=<value>\n"
"Modifies the current configuration.\n"
"Example: 'set debug=true', 'set theme=dark'"
msgstr ""
"Utilisation : set <param>=<value>\n"
"Modifie la configuration actuelle.\n"
"Exemple : 'set debug=true', 'set theme=dark'"

#: othello/common/command.py:395
msgid ""
"Usage: hint\n"
"Asks the engine for a move suggestion."
msgstr ""
"Utilisation : indice\n"
"Demande au moteur une suggestion de déplacement."

#: othello/common/command.py:396
msgid ""
"Usage: pause\n"
"Pauses the game timer (Blitz mode)."
msgstr ""
"Utilisation : pause\n"
"Met le chronomètre de jeu en pause (mode Blitz)."

#: othello/common/command.py:398
msgid ""
"Usage: server <list|start [port]|stop|status>\n"
"Manages the local Othello server.\n"
" - list : See available servers on the local network.\n"
" - start : Starts a server on the given port (default 12345).\n"
" - stop : Stops the current running server.\n"
" - status : Displays information about the current server state."
msgstr ""
"Utilisation : serveur <list|start [port]|stop|status>\n"
"Gère le serveur Othello local.\n"
" - liste : Voir les serveurs disponibles sur le réseau local.\n"
" - start : Démarre un serveur sur le port donné (par défaut 12345).\n"
" - stop : Arrête le serveur en cours d'exécution.\n"
" - status : Affiche des informations sur l'état actuel du serveur."

#: othello/common/command.py:408
msgid ""
"Usage: join <ip:port> [id]\n"
"Connect to an existing Othello server.\n"
"Example: 'join 192.168.1.10:12345' or 'join bob' if bob was your previous ID."
msgstr ""
"Utilisation : rejoindre <ip:port> [id]\n"
"Connectez-vous à un serveur Othello existant.\n"
"Exemple : « rejoindre 192.168.1.10:12345 » ou « rejoindre bob » si bob était votre identifiant précédent."

#: othello/common/command.py:414
msgid ""
"Usage: ping\n"
"Tests the connection to the connected server."
msgstr ""
"Utilisation : ping\n"
"Teste la connexion au serveur connecté."

#: othello/common/command.py:417
msgid ""
"Usage: players or players [PLAYER_ID] for details\n"
"Lists all players or shows details for a specific player.\n"
"Details include status (idle, away, waitgame, ingame), score, and statistics."
msgstr ""
"Utilisation : joueurs ou joueurs [PLAYER_ID] pour plus de détails\n"
"Répertorie tous les joueurs ou affiche les détails d'un joueur spécifique.\n"
"Les détails incluent le statut (inactif, absent, waitgame, ingame), le score et les statistiques."

#: othello/common/command.py:423
msgid ""
"Usage: scoreboard\n"
"Displays the current scoreboard from the server."
msgstr ""
"Utilisation : tableau de bord\n"
"Affiche le tableau de bord actuel du serveur."

#: othello/common/command.py:427
msgid ""
"Usage: name <pseudo>\n"
"Changes your player name on the server."
msgstr ""
"Utilisation : nom <pseudo>\n"
"Change votre nom de joueur sur le serveur."

#: othello/common/command.py:430
msgid ""
"Usage: quit [force]\n"
"Exits the game or disconnects from server."
msgstr ""
"Utilisation : quitter [forcer]\n"
"Exits the game or disconnects from server."

#: othello/common/command.py:434
msgid ""
"Usage: help [command]\n"
"Displays this list or details for a specific command."
msgstr ""
"Utilisation : aide [commande]\n"
"Affiche cette liste ou les détails d'une commande spécifique."

#: othello/common/command.py:437
msgid ""
"Usage: accept\n"
"Accepts a pending game invitation."
msgstr ""
"Utilisation : accepter\n"
"Accepte une invitation à un jeu en attente."

#: othello/common/command.py:438
msgid ""
"Usage: decline\n"
"Refuses a pending game invitation."
msgstr ""
"Utilisation : refuser\n"
"Refuse une invitation à un jeu en attente."

#: othello/common/command.py:440
msgid ""
"Usage: cancel\n"
"Cancels an invitation you have sent (if still pending)."
msgstr ""
"Utilisation : annuler\n"
"Annule une invitation que vous avez envoyée (si elle est toujours en attente)."

#: othello/common/command.py:444
msgid ""
"Usage: away\n"
"Sets your status to 'away' (no invitations received)."
msgstr ""
"Utilisation : à l'extérieur\n"
"Définit votre statut sur « absent » (aucune invitation reçue)."

#: othello/common/command.py:447
msgid ""
"Usage: back\n"
"Sets your status back to 'idle'."
msgstr ""
"Utilisation : retour\n"
"Rétablit votre statut sur « inactif »."

#: othello/common/command.py:449
msgid ""
"Usage: waitgame\n"
"Displays your current search/invitation status."
msgstr ""
"Utilisation : attendre le jeu\n"
"Affiche votre statut actuel de recherche/invitation."

#: othello/common/command.py:457
#, python-brace-format
msgid ""
"--- Help: {topic_key} ---\n"
"{details}"
msgstr ""
"--- Aide : {topic_key} ---\n"
"{details}"

#: othello/common/command.py:464
#, python-brace-format
msgid "No help available for command '{topic}'."
msgstr "Aucune aide disponible pour la commande '{topic}'."

#: othello/common/command.py:470
msgid ""
"Available commands (type 'help <CMD>' for details):\n"
"---------------------------------------------------\n"
" - Game      : new, load, save, quit\n"
" - Play      : <Color> <Coord> (e.g. X E4), undo, redo, hint\n"
" - Info      : show (board, history, time, configuration),\n"
"              scoreboard, players, waitgame\n"
" - Settings  : set, pause, name, away, back\n"
" - Network   : join, server, ping, players, accept, decline, cancel\n"
" - System    : help\n"
msgstr ""
"Commandes disponibles (tapez 'help <CMD>' pour plus de détails) :\n"
"---------------------------------------------------\n"
" - Jeu : new, load, save, quit\n"
" - Lecture : : <Color> <Coord> (e.g. X E4), undo, redo, hint\n"
" - Infos : show (board, history, time, configuration),\n"
"              scoreboard, players, waitgame\n"
" - Paramètres : set, pause, name, away, back\n"
" - Réseau : join, server, ping, players, accept, decline, cancel\n"
" - Système : help\n"

#: othello/common/command.py:517
msgid "Cannot save game during a network match. Finish or disconnect first."
msgstr ""
"Impossible de sauvegarder la partie pendant une partie en réseau. Terminez "
"ou déconnectez-vous d’abord."

#: othello/common/command.py:527
msgid "Usage: save <filename> [comment]"
msgstr "Utilisation : save <filename> [commentaire]"

#: othello/common/command.py:560
msgid "Cannot load game during a network match."
msgstr "Impossible de charger le jeu pendant une partie en réseau."

#: othello/common/command.py:567
#, python-brace-format
msgid "Game loaded from {filename}"
msgstr "Jeu chargé depuis {filename}"

#: othello/common/command.py:572
msgid "Usage: load <filename>"
msgstr "Utilisation : charger <nom de fichier>"

#: othello/common/command.py:605
msgid "Undo is not available in network mode."
msgstr "L'annulation n'est pas disponible en mode réseau."

#: othello/common/command.py:611
#, python-brace-format
msgid "Undid {n} move(s)."
msgstr "Annuler {n} mouvements."

